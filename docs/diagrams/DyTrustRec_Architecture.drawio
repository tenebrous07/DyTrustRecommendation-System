<mxfile host="app.diagrams.net"><diagram id="page1" name="Fig. 1 -- DyTrustRec Full System Architecture"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1580" math="0" shadow="0"><root><mxCell id="page1-0" />
<mxCell id="page1-1" parent="page1-0" />
<mxCell id="page1-c_ing" value="Data Ingestion, Cleaning &amp; Leakage-Safe Split -- Modules 1-3, 22" style="rounded=1;dashed=1;strokeColor=#C77D2E;fillColor=none;verticalAlign=top;align=left;fontColor=#C77D2E;fontStyle=1;spacingLeft=8;" vertex="1" parent="page1-1"><mxGeometry x="20" y="150" width="1860" height="175" as="geometry" /></mxCell>
<mxCell id="page1-c_feat" value="(a) Feature Engineering -- Sentiment, Semantics &amp; Fusion -- Modules 5-8" style="rounded=1;dashed=1;strokeColor=#C77D2E;fillColor=none;verticalAlign=top;align=left;fontColor=#C77D2E;fontStyle=1;spacingLeft=8;" vertex="1" parent="page1-1"><mxGeometry x="20" y="390" width="970" height="390" as="geometry" /></mxCell>
<mxCell id="page1-c_graph" value="(b) Trust-Aware Heterogeneous Graph -- Modules 9, 11-13" style="rounded=1;dashed=1;strokeColor=#C77D2E;fillColor=none;verticalAlign=top;align=left;fontColor=#C77D2E;fontStyle=1;spacingLeft=8;" vertex="1" parent="page1-1"><mxGeometry x="1020" y="390" width="860" height="390" as="geometry" /></mxCell>
<mxCell id="page1-c_hgt" value="Heterogeneous Graph Transformer (HGT) Encoder -- Module 14" style="rounded=1;dashed=1;strokeColor=#3D6FB0;fillColor=none;verticalAlign=top;align=left;fontColor=#3D6FB0;fontStyle=1;spacingLeft=8;" vertex="1" parent="page1-1"><mxGeometry x="20" y="830" width="1860" height="230" as="geometry" /></mxCell>
<mxCell id="page1-inp" value="Dataset&lt;br&gt;Amazon Reviews 2023 (Video_Games tier)&lt;br&gt;262,547 raw rows&lt;br&gt;replicated on Musical_Instruments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7C2;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="40" y="24" width="300" height="96" as="geometry" /></mxCell>
<mxCell id="page1-ing" value="MODULE 1&lt;br&gt;Ingestion &amp;amp; Schema Adapter&lt;br&gt;field presence checked, never invented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="60" y="195" width="280" height="118" as="geometry" /></mxCell>
<mxCell id="page1-clean" value="MODULE 2&lt;br&gt;Cleaning &amp;amp; k-core Filter&lt;br&gt;262,547 -&amp;gt; 144,178 rows (54.9% retained)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="380" y="195" width="280" height="118" as="geometry" /></mxCell>
<mxCell id="page1-split" value="MODULE 22&lt;br&gt;Chronological Split -- 80/10/10&lt;br&gt;train 115,342 * val 14,418 * test 14,418" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E7E7;strokeColor=#8A8F98;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="700" y="195" width="280" height="118" as="geometry" /></mxCell>
<mxCell id="page1-leak" value="ENFORCED&lt;br&gt;Leakage Guards&lt;br&gt;6 assertions in tests/ -- no val/test&lt;br&gt;edge ever enters the training graph&lt;br&gt;terminal -- a check on the split,&lt;br&gt;not a data-producing stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8B4B4;strokeColor=#B33B3B;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1020" y="195" width="320" height="118" as="geometry" /></mxCell>
<mxCell id="page1-eda" value="MODULES 3-4&lt;br&gt;EDA * Outlier Analysis&lt;br&gt;18.7% corroborated outliers (&amp;gt;=2 detectors agree) --&lt;br&gt;flagged, never deleted, so the trust detectors have evidence to find&lt;br&gt;terminal -- informs design decisions and the written&lt;br&gt;report (Sec. G); nothing downstream consumes it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3DFA0;strokeColor=#C9A227;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1380" y="195" width="460" height="118" as="geometry" /></mxCell>
<mxCell id="page1-text" value="review_title + review_text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E7E7;strokeColor=#8A8F98;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="60" y="440" width="290" height="90" as="geometry" /></mxCell>
<mxCell id="page1-struct5" value="MODULE 5&lt;br&gt;5 Structured Features&lt;br&gt;length * helpfulness * verified *&lt;br&gt;recency * rating-centred" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E7E7;strokeColor=#8A8F98;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="60" y="560" width="290" height="130" as="geometry" /></mxCell>
<mxCell id="page1-sent" value="MODULE 6&lt;br&gt;BERT Sentiment Encoder&lt;br&gt;nlptown/bert-base-multilingual-&lt;br&gt;uncased-sentiment -&amp;gt; pos/neg/neu/compound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="390" y="440" width="320" height="120" as="geometry" /></mxCell>
<mxCell id="page1-sbert" value="MODULE 7&lt;br&gt;SBERT Semantic Encoder&lt;br&gt;all-MiniLM-L6-v2 * mean-pool * L2-norm&lt;br&gt;-&amp;gt; 384-d, unit-norm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="390" y="580" width="320" height="120" as="geometry" /></mxCell>
<mxCell id="page1-fusion" value="MODULE 8&lt;br&gt;Semantic-Behavioural&lt;br&gt;Fusion Layer&lt;br&gt;concat -&amp;gt; LayerNorm -&amp;gt;&lt;br&gt;Linear(390-&amp;gt;256) -&amp;gt; GELU -&amp;gt;&lt;br&gt;Dropout -&amp;gt; Linear(256-&amp;gt;128)&lt;br&gt;ablated: no gain over concatenation;&lt;br&gt;the best variant bypasses it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBD1EC;strokeColor=#4472C4;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="750" y="490" width="220" height="170" as="geometry" /></mxCell>
<mxCell id="page1-hgraph" value="5-type heterogeneous graph G = (V, E)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1DD;strokeColor=#C9A227;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1060" y="440" width="330" height="170" as="geometry" /></mxCell>
<mxCell id="page1-cola" value="MODULE 11&lt;br&gt;Behavioural Trust Detector&lt;br&gt;indicators: shared text * repeats * bursts *&lt;br&gt;paraphrase match (sentence embeddings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1440" y="440" width="400" height="105" as="geometry" /></mxCell>
<mxCell id="page1-anomtrust" value="MODULE 12&lt;br&gt;Anomaly -&amp;gt; Trust&lt;br&gt;tau = 1 - rank-norm(score), clamp [0.05, 1];&lt;br&gt;flagged accounts are gated out of the graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1440" y="565" width="400" height="105" as="geometry" /></mxCell>
<mxCell id="page1-temporal" value="MODULE 13&lt;br&gt;Temporal Recency Weight&lt;br&gt;exp(-lambda*age), lambda=2 (tuned on validation), floor 0.01&lt;br&gt;age from max(train.timestamp), never now" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1060" y="640" width="330" height="105" as="geometry" /></mxCell>
<mxCell id="page1-wgraph" value="OUTPUT&lt;br&gt;Trust x Recency Sample Weights&lt;br&gt;w_e = base * tau_e^a * recency_e^b scales each BPR term&lt;br&gt;(HGTConv cannot read an edge weight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE3C6;strokeColor=#6E9F5E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1440" y="690" width="400" height="90" as="geometry" /></mxCell>
<mxCell id="page1-proj" value="Type-Specific Linear&lt;br&gt;Projection -&amp;gt; 128-d&lt;br&gt;per node type: user 20-d, product 18-d,&lt;br&gt;review 390-d, brand/category learned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBD1EC;strokeColor=#4472C4;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="60" y="885" width="280" height="130" as="geometry" /></mxCell>
<mxCell id="page1-emb" value="OUTPUT&lt;br&gt;User / Product Embeddings&lt;br&gt;128-d, score(u,i) = e_u . e_i" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE3C6;strokeColor=#6E9F5E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="780" y="890" width="280" height="105" as="geometry" /></mxCell>
<mxCell id="page1-bpr" value="MODULE 20/31&lt;br&gt;BPR Objective, AdamW, Edge-Masked Training&lt;br&gt;each epoch 50% of interaction edges are hidden from message passing&lt;br&gt;and become the targets; validation NDCG@10 early-stops and restores the best epoch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1200" y="890" width="560" height="105" as="geometry" /></mxCell>
<mxCell id="page1-scoring" value="MODULE 15&lt;br&gt;Recommendation Scoring&lt;br&gt;Full-catalogue ranking, positives masked;&lt;br&gt;last r slots: new products by text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="60" y="1100" width="420" height="110" as="geometry" /></mxCell>
<mxCell id="page1-expl" value="MODULE 16&lt;br&gt;Explanation Branch&lt;br&gt;6 evidence sources; each cited fact is&lt;br&gt;tested by removing it and re-running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="520" y="1100" width="420" height="110" as="geometry" /></mxCell>
<mxCell id="page1-cf" value="MODULE 17&lt;br&gt;Counterfactual Branch&lt;br&gt;Bisection search over one perturbable&lt;br&gt;factor -&amp;gt; magnitude to enter Top-K, or infeasible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="980" y="1100" width="420" height="110" as="geometry" /></mxCell>
<mxCell id="page1-conf" value="MODULE 18&lt;br&gt;Confidence Branch&lt;br&gt;evidence sufficiency 0.5 / 0.3 / 0.2, plus&lt;br&gt;a separately calibrated hit probability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C57C;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1440" y="1100" width="400" height="110" as="geometry" /></mxCell>
<mxCell id="page1-finalout" value="Trust-Calibrated Explainable Top-K Recommendation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE3C6;strokeColor=#6E9F5E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="40" y="1390" width="1820" height="60" as="geometry" /></mxCell>
<mxCell id="page1-dash" value="MODULE 39&lt;br&gt;Streamlit Dashboard&lt;br&gt;reads generated artefacts only --&lt;br&gt;trains nothing, computes no metric of its own" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7C2;strokeColor=#C77D2E;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="page1-1"><mxGeometry x="1500" y="1465" width="360" height="90" as="geometry" /></mxCell>
<mxCell id="page1-n_feat" value="concat arm (mode=&quot;concat&quot;) kept alongside the learned projection so &quot;does fusion beat&lt;br&gt;concatenation?&quot; is answered, not assumed. Measured: it does not (Table V)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="page1-1"><mxGeometry x="60" y="731" width="620" height="40" as="geometry" /></mxCell>
<mxCell id="page1-n_hgt" value="HGT: 2 layers x 4-head relational attention, full-batch" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="page1-1"><mxGeometry x="380" y="1025" width="620" height="40" as="geometry" /></mxCell>
<mxCell id="page1-n_mat" value="y_u,i score map (illustrative)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="page1-1"><mxGeometry x="60" y="1358" width="620" height="40" as="geometry" /></mxCell>
<mxCell id="page1-n_bars" value="confidence blend" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="page1-1"><mxGeometry x="1440" y="1214" width="620" height="40" as="geometry" /></mxCell>
<mxCell id="page1-n_live" value="Live example (real run, un-curated: the evaluable user with the longest history): &#x27;Sega Dreamcast Console&#x27; recommended to a user with 117 training interactions and trust 0.996. 9 high-trust users with overlapping history also bought&lt;br&gt;it, it belongs to legacy systems, which dominates the user&#x27;s history, and the user&#x27;s recent activity is concentrated in legacy systems. Held-out outcome: the top item was not a hit in the test split." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="page1-1"><mxGeometry x="40" y="1470" width="620" height="40" as="geometry" /></mxCell>
