            "max_users": 30000,
            "max_products": 40000
          },
          "k_core": {
            "min_interactions_per_user": 5,
            "min_interactions_per_item": 5,
            "max_passes": 100
          }
        },
        "full": {
          "category": "Electronics",
          "reviews_url": "https://huggingface.co/datasets/McAuley-Lab/Amazon-Reviews-2023/resolve/main/raw/review_categories/Electronics.jsonl",
          "meta_url": "https://huggingface.co/datasets/McAuley-Lab/Amazon-Reviews-2023/resolve/main/raw/meta_categories/meta_Electronics.jsonl",
          "materialise": false,
          "stream_byte_budget": 2147483648,
          "limits": {
            "max_reviews": 1000000,
            "max_users": 100000,
            "max_products": 150000
          },
          "k_core": {
            "min_interactions_per_user": 5,
            "min_interactions_per_item": 5,
            "max_passes": 100
          }
        }
      },
      "sampling": {
        "strategy": "user_core",
        "seed": 42,
        "declare_bias": true
      },
      "schema": {
        "interactions": {
          "source_file": "reviews",
          "field_map": {
            "user_id": "user_id",
            "item_id": "parent_asin",
            "variant_id": "asin",
            "rating": "rating",
            "review_title": "title",
            "review_text": "text",
            "timestamp": "timestamp",
            "helpful_votes": "helpful_vote",
            "verified_purchase": "verified_purchase"
          },
          "required": [
            "user_id",
            "item_id",
            "rating",
            "timestamp"
          ]
        },
        "products": {
          "source_file": "meta",
          "field_map": {
            "item_id": "parent_asin",
            "product_title": "title",
            "product_description": "description",
            "product_features": "features",
            "brand": "store",
            "main_category": "main_category",
            "categories": "categories",
            "price": "price",
            "avg_rating_meta": "average_rating",
            "rating_count_meta": "rating_number",
            "details": "details",
            "seller": null
          },
          "required": [
            "item_id"
          ]
        },
        "notes": {
          "brand_is_store": "Amazon Reviews 2023 has NO `brand` field. `store` is the Amazon storefront name, which usually but not always coincides with the manufacturer. We map store -> brand and label the graph node type `Brand (proxy: store)`. This is an approximation and is reported as such; it is not a ground-truth brand.\n",
          "seller_absent": "There is NO seller field. Per the project rule against inventing entities, the heterogeneous graph therefore has NO Seller node type and no `sold_by` edge. The architecture diagram must reflect this.\n",
          "categories_sparse": "`categories` is an empty list for a large share of products. `main_category` is far better populated. The Category node type is built primarily from main_category, with the `categories` leaf used only when non-empty.\n",
          "price_sparse": "`price` is null for a large share of products and is a string in some rows. Price is treated as an optional feature with an explicit missingness indicator, never imputed silently.\n",
          "no_fraud_labels": "There are NO fake-review or fraud labels. Trust scores from Module 11/12 are therefore UNSUPERVISED and cannot be scored against ground truth. Evaluation uses synthetic injection experiments (Module 45), which must always be reported as synthetic.\n"
        }
      },
      "cleaning": {
        "rating": {
          "min": 1.0,
          "max": 5.0
        },
        "timestamp": {
          "min_iso": "1996-01-01T00:00:00Z",
          "max_iso": "2023-12-31T23:59:59Z",
          "unit": "ms"
        },
        "text": {
          "strip_html": true,
          "normalise_whitespace": true,
          "unescape_entities": true,
          "lowercase": false,
          "min_length_chars": 0
        },
        "duplicates": {
          "exact_keys": [
            "user_id",
            "item_id",
            "timestamp"
          ],
          "flag_repeated_text_by_user": true
        },
        "outliers": {
          "action": "flag",
          "flag_column": "outlier_flag"
        }
      },
      "paths": {
        "raw": "data/raw",
        "interim": "data/interim",
        "processed": "data/processed",
        "embeddings": "data/embeddings",
        "reports": "reports",
        "figures": "reports/figures",
        "tables": "reports/tables",
        "results": "reports/results"
      },
      "split": {
        "strategy": "global_temporal",
        "train_frac": 0.8,
        "val_frac": 0.1,
        "test_frac": 0.1,
        "enforce_no_future_edges": true
      }
    },
    "model": {
      "device": "auto",
      "seed": 42,
      "sbert": {
        "model_name": "sentence-transformers/all-MiniLM-L6-v2",
        "embedding_dimension": 384,
        "max_seq_length": 256,
        "batch_size": 256,
        "normalize_embeddings": true,
        "cache": true,
        "cache_format": "npy",
        "cache_dir": "data/embeddings",
        "device": "auto",
        "text_fields": [
          "review_title",
          "review_text"
        ],
        "join_with": ". ",
        "empty_text_policy": "zero_vector"
      },
      "sentiment": {
        "backend": "transformer",
        "model_name": "nlptown/bert-base-multilingual-uncased-sentiment",
        "outputs": [
          "pos",
          "neg",
          "neu",
          "compound"
        ],
        "device": "auto",
        "batch_size": 64,
        "max_length": 256
      },
      "fusion": {
        "output_dimension": 128,
        "hidden_dimension": 256,
        "dropout": 0.2,
        "activation": "gelu",
        "layer_norm": true,
        "structured_features": [
          "sentiment_compound",
          "review_length_log",
          "helpful_votes_log",
          "verified_purchase_f",
          "recency_weight",
          "rating_centred"
        ],
        "mode": "mlp"
      },
      "graph": {
        "node_types": [
          "user",
          "product",
          "review",
          "brand",
          "category"
        ],
        "edge_types": [
          [
            "user",
            "wrote",
            "review"
          ],
          [
            "review",
            "about",
            "product"
          ],
          [
            "user",
            "purchased",
            "product"
          ],
          [
            "product",
            "belongs_to",
            "category"
          ],
          [
            "product",
            "manufactured_by",
            "brand"
          ]
        ],
        "add_reverse_edges": true,
        "include_review_nodes": true
      },
      "cola": {
        "projection": "user_product_bipartite",
        "hidden_dimension": 64,
        "num_layers": 1,
        "dropout": 0.1,
        "subgraph_size": 4,
        "negative_ratio": 1,
        "epochs": 100,
        "learning_rate": 0.001,
        "weight_decay": 0.0,
        "eval_rounds": 32,
        "has_ground_truth_labels": false
      },
      "trust": {
        "normalisation": "rank",
        "transform": "one_minus",
        "floor": 0.05,
        "ceiling": 1.0,
        "scored_entity": "user",
        "propagate_to": "interaction",
        "aggregation": "mean"
      },
      "temporal": {
        "enabled": true,
        "decay": "exponential",
        "lambda_per_year": 0.5,
        "reference": "max_train_timestamp",
        "min_weight": 0.01,
        "snapshots": {
          "enabled": true,
          "granularity": "year"
        }
      },
      "edge_weighting": {
        "base": 1.0,
        "trust_exponent": 1.0,
        "temporal_exponent": 1.0,
        "use_trust": true,
        "use_temporal": true
      },
      "hgt": {
        "hidden_channels": 128,
        "num_heads": 4,
        "num_layers": 2,
        "dropout": 0.2,
        "use_norm": true,
        "output_dimension": 128
      },
      "scoring": {
        "head": "dot",
        "mlp_hidden": [
          128,
          64
        ],
        "subtract_popularity_bias": false
      },
      "confidence": {
        "method": "mc_dropout",
        "mc_samples": 20,
        "components": {
          "predictive_stability": 0.5,
          "evidence_volume": 0.3,
          "evidence_trust": 0.2
        },
        "cold_start_penalty": true
      },
      "cold_start": {
        "min_interactions_for_personalised": 3,
        "new_user_strategy": "popularity_within_preferred_category",
        "new_item_strategy": "content_similarity",
        "report_separately": true
      },
      "explainability": {
        "max_paths": 5,
        "max_path_length": 3,
        "evidence_sources": [
          "shared_category",
          "shared_brand",
          "similar_trusted_users",
          "recent_interaction",
          "semantic_similarity",
          "review_sentiment"
        ],
        "require_evidence": true
      },
      "counterfactual": {
        "top_k": 5,
        "search": "bisection",
        "max_iterations": 20,
        "perturbable_factors": [
          "category_affinity",
          "brand_affinity",
          "recency_weight",
          "trust_weight",
          "semantic_similarity"
        ],
        "report_infeasible": true
      }
    }
  },
